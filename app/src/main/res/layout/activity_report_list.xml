<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReportListActivity"
    android:orientation="vertical">

    <!-- Status Bar Area -->
    <fragment
        android:id="@+id/headerFragment"
        android:name="com.example.zikk.ui.HeaderFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <!-- 메인 컨텐츠 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- 신고 건수 및 필터 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 신고 건수 및 필터 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 총 신고 건수 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="총 신고 건수 : 30건"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp" />

                <!-- 필터 버튼들 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/filter_processing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/report_list_processing" />

                    <ImageView
                        android:id="@+id/filter_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/report_list_accepted" />

                    <ImageView
                        android:id="@+id/filter_rejected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/report_list_rejected" />
                </LinearLayout>

                <!-- 정렬 옵션 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right">

                    <ImageView
                        android:id="@+id/sort_latest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/report_list_sort1"
                        android:layout_marginEnd="10dp"/>

                    <ImageView
                        android:id="@+id/sort_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/report_list_sort2"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 신고 목록 (고정 4개 항목) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 신고 항목 1 (노란색 - 처리중) -->
                <LinearLayout
                    android:id="@+id/report_item_1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FFF9C4"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 위치: 시흥시 OO구 OO동 34-2"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 유형: 접차불통"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 시간: 2025-00-00 11:30"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <!-- 화살표 아이콘 -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginTop="-60dp" />

                </LinearLayout>

                <!-- 신고 항목 2 (파란색) -->
                <LinearLayout
                    android:id="@+id/report_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#E3F2FD"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 위치: 시흥시 OO구 OO동 34-2"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 유형: 접차불통"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 시간: 2025-00-00 11:30"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginTop="-60dp" />

                </LinearLayout>

                <!-- 신고 항목 3 (분홍색) -->
                <LinearLayout
                    android:id="@+id/report_item_3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FCE4EC"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 위치: 시흥시 OO구 OO동 34-2"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 유형: 접차불통"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 시간: 2025-00-00 11:30"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginTop="-60dp" />

                </LinearLayout>

                <!-- 신고 항목 4 (파란색) -->
                <LinearLayout
                    android:id="@+id/report_item_4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#E3F2FD"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 위치: 시흥시 OO구 OO동 34-2"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 유형: 접차불통"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 시간: 2025-00-00 11:30"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginTop="-60dp" />

                </LinearLayout>

                <!-- 신고 항목 5 (노란색 - 처리중) -->
                <LinearLayout
                    android:id="@+id/report_item_5"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FFF9C4"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 위치: 시흥시 OO구 OO동 34-2"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 유형: 접차불통"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신고 시간: 2025-00-00 11:30"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="4dp" />

                    <!-- 화살표 아이콘 -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginTop="-60dp" />

                </LinearLayout>

                <!-- 페이지네이션 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/btn_prev_page"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_marginHorizontal="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:layout_marginHorizontal="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_marginHorizontal="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:layout_marginHorizontal="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:layout_marginHorizontal="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:layout_marginHorizontal="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp" />

                    <ImageView
                        android:id="@+id/btn_next_page"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/baseline_chevron_right_24"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
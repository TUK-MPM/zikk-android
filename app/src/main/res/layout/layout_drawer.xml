<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="48dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZIKK"
        android:textColor="@color/blue"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="시흥시 개인형 이동장치 신고 앱" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:orientation="vertical">

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/list_button_first"
            android:drawableEnd="@drawable/baseline_chevron_right_24"
            android:drawableTint="@color/black"
            android:padding="12dp"
            android:text="신고 가이드 보러가기"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:rippleColor="@color/light_gray" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/list_button"
            android:drawableEnd="@drawable/baseline_chevron_right_24"
            android:drawableTint="@color/black"
            android:includeFontPadding="false"
            android:padding="12dp"
            android:text="신고하기"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:rippleColor="@color/light_gray" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/list_button_last"
            android:drawableEnd="@drawable/baseline_chevron_right_24"
            android:drawableTint="@color/black"
            android:includeFontPadding="false"
            android:padding="12dp"
            android:text="신고 내역 조회하기"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:rippleColor="@color/light_gray" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="30dp" />

    <LinearLayout
        android:layout_marginBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/list_button_first"
            android:padding="12dp"
            android:text="공지사항"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            app:backgroundTint="@color/white" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/list_button_last"
            android:padding="12dp"
            android:text="1:1 문의"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            app:backgroundTint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:paddingHorizontal="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_marginVertical="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="의견 보내기" />

        <TextView
            android:layout_marginVertical="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정" />

        <TextView
            android:layout_marginVertical="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="관리자 로그인" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReportListActivity"
    android:orientation="vertical"
    android:background="@color/background_orange">

    <!-- Status Bar Area -->
    <fragment
        android:id="@+id/headerFragment"
        android:name="com.example.zikk.ui.HeaderFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <!-- 메인 컨텐츠 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 헤더 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/iv_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/baseline_arrow_back_ios_30"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="뒤로가기"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_report_list_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 신고 내역"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:layout_centerInParent="true" />
            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_totalreport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="총 신고 건수: "
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <!-- 필터 & 정렬 옵션 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp">

                    <ImageView
                        android:id="@+id/iv_character"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/ic_emoji_reportlist_page"
                        android:layout_gravity="start"
                        android:layout_marginLeft="12dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_gravity="end"
                        android:layout_marginTop="35dp">



                        <TextView
                            android:id="@+id/filter_processing"
                            android:layout_width="46dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/round_box"
                            android:backgroundTint="@color/milk"
                            android:gravity="center"
                            android:text="처리중"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/filter_completed"
                            android:layout_width="46dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/round_box"
                            android:backgroundTint="@color/deap_blue"
                            android:gravity="center"
                            android:text="완료"
                            android:textSize="10sp"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/filter_rejected"
                            android:layout_width="46dp"
                            android:layout_height="20dp"
                            android:background="@drawable/round_box"
                            android:backgroundTint="@color/deap_orange"
                            android:gravity="center"
                            android:text="완료"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_gravity="end"
                        android:layout_marginTop="60dp">

                        <Button
                            android:id="@+id/btn_sort_status"
                            android:layout_width="wrap_content"
                            android:layout_height="25dp"
                            android:background="@drawable/round_box_large"
                            android:backgroundTint="@color/sort_gray"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:layout_marginEnd="8dp"
                            android:paddingHorizontal="10dp"
                            android:text="최신순으로 나열"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reportRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:nestedScrollingEnabled="false"/>

            <!-- 페이지네이션 (FlexboxLayout 활용) -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/paginationLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                app:flexWrap="wrap"
                app:justifyContent="center" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
